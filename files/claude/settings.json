{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/awesome-statusline.sh"
  },
  "advisorModel": "opus",
  "theme": "auto",
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
